# Issue 10 — Real LLM adapter configuration.
# Copy this file to `.env` (same directory) and fill in your OpenAI-compatible
# API credentials. Process environment variables take precedence over `.env`.

# API base URL (adapter appends /chat/completions).
REPOQA_LLM_BASE=https://api.openai.com/v1
REPOQA_LLM_API_KEY=sk-xxxx
REPOQA_LLM_MODEL=gpt-4o-mini

# Optional: full chat-completions endpoint. When set, it overrides REPOQA_LLM_BASE.
# REPOQA_LLM_URL=http://127.0.0.1:8000/v1/chat/completions

# Gate: the real LLM path is only used for architecture-mode queries after the
# Golden Dataset eval passes. Set to 1 to enable it.
# REPOQA_GATES_PASSED=1