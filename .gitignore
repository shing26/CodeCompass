node_modules/
dist/
*.db
*.db-wal
*.db-shm
.env
.DS_Store
Thumbs.db

# Local gh askpass helper (contains a token invocation) — never commit.
.git-askpass.ps1

# E2E gate scratch artifacts (sample repo, indexed data, screenshots, probes).
# Issue-tracker convention (docs/agents/issue-tracker.md) keeps specs/issues as
# markdown under .scratch/<feature>/ — those must stay tracked. Ignore the
# artifacts, re-include directories and *.md (v0.23.0: specs were silently
# untracked before this negation).
.scratch/**
!.scratch/**/
!.scratch/**/*.md

# Test runner artifacts.
test-results/

# Gate run output (regenerated on every run).
scripts/e2e/e2e-result.json

# Python bytecode.
__pycache__/

# Agent-local tool state (session plugins, workbuddy, penguin).
.mimosa/
.penguin/
.workbuddy/
.zcode/

# Product-experience report screenshots (large binary evidence, kept local).
# Round1 t*-* shots were committed in the v0.6 era — tracked files stay tracked
# (Round2's r2-* set was lost before this archiving pass); everything from
# Round3 on stays local-only, mirroring the root image*.png policy below.
docs/reports/ui-shots/

# Ad-hoc screenshots dropped at repo root during real-use feedback rounds
# (v0.25.0 收口: binary evidence stays local; archive reference shots into
# docs/reports/ui-shots/ instead of dropping them at the root).
/image*.png

# Precision harness raw dumps (regenerated; verdicts/ are the committed evidence).
scripts/precision/out/
